{
  "expo": {
    "name": "BJJ Club Manager",
    "slug": "bjj-club",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "bjjclub",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0F14"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "club.bjj.manager",
      "infoPlist": {
        "NSCameraUsageDescription": "Aplikacja używa kamery do zeskanowania kodu QR przy wejściu do klubu."
      }
    },
    "android": {
      "package": "club.bjj.manager",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "backgroundColor": "#0B0F14",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.CAMERA"]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Aplikacja używa kamery do zeskanowania kodu QR przy wejściu do klubu."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
